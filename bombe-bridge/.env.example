# MQTT (HiveMQ)
MQTT_BROKER=mqtt://broker.hivemq.com:1883
MQTT_TOPIC=home/safety/device_001
MQTT_CLIENT_ID=bombe-bridge-kelompok4

# Firebase Realtime Database
FIREBASE_DATABASE_URL=https://bombeiotc4-default-rtdb.asia-southeast1.firebasedatabase.app
DEVICE_ID=device_001

# Firebase Auth (wajib jika database rules memerlukan auth != null)
FIREBASE_API_KEY=your_api_key_here
FIREBASE_EMAIL=admin@gmail.com
FIREBASE_PASSWORD=your_password_here

# HTTP monitoring server
PORT=3000
